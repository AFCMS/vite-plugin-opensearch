{
    "name": "@afcms/vite-plugin-opensearch",
    "version": "0.2.2",
    "description": "Generate OpenSearch 1.1 browser search descriptions with Vite",
    "keywords": [
        "browser-search",
        "opensearch",
        "vite-plugin",
        "xml"
    ],
    "homepage": "https://github.com/AFCMS/vite-plugin-opensearch#readme",
    "bugs": {
        "url": "https://github.com/AFCMS/vite-plugin-opensearch/issues"
    },
    "license": "MIT",
    "author": {
        "name": "AFCMS",
        "email": "afcm.contact@gmail.com",
        "url": "https://afcms.dev"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AFCMS/vite-plugin-opensearch.git"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/AFCMS"
        }
    ],
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": {
        ".": "./dist/index.mjs",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "release": "bumpp",
        "prepublishOnly": "pnpm run build",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "prepare": "husky"
    },
    "devDependencies": {
        "@arethetypeswrong/core": "^0.18.5",
        "@types/node": "^24.13.3",
        "bumpp": "^12.3.0",
        "husky": "^9.1.7",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "oxlint-tsgolint": "^7.0.2008",
        "publint": "^0.3.25",
        "tsdown": "^0.23.7",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "peerDependencies": {
        "vite": "^8"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^12",
            "onFail": "error"
        },
        "runtime": {
            "name": "node",
            "version": "^24",
            "onFail": "error"
        }
    },
    "engines": {
        "node": ">=24"
    },
    "compatiblePackages": {
        "schemaVersion": 1,
        "vite": {
            "type": "compatible",
            "versions": "^8.0.0"
        },
        "rollup": {
            "type": "incompatible"
        },
        "rolldown": {
            "type": "incompatible"
        }
    }
}
