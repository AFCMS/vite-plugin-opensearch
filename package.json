{
    "name": "@afcms/vite-plugin-opensearch",
    "version": "0.0.0",
    "description": "",
    "keywords": [
        "vite-plugin"
    ],
    "homepage": "https://github.com/AFCMS/vite-plugin-opensearch#readme",
    "bugs": {
        "url": "https://github.com/AFCMS/vite-plugin-opensearch/issues"
    },
    "license": "MIT",
    "author": "AFCMS <afcm.contact@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AFCMS/vite-plugin-opensearch.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": {
        ".": "./dist/index.mjs",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "test": "vitest",
        "typecheck": "tsc --noEmit",
        "release": "bumpp",
        "prepublishOnly": "pnpm run build",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint"
    },
    "devDependencies": {
        "@arethetypeswrong/core": "^0.18.5",
        "@types/node": "^26.1.1",
        "bumpp": "^11.1.0",
        "oxfmt": "^0.59.0",
        "oxlint": "^1.74.0",
        "oxlint-tsgolint": "^0.25.0",
        "publint": "^0.3.21",
        "tsdown": "^0.22.5",
        "typescript": "^7.0.2",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "vite": "^8"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^11",
            "onFail": "error"
        },
        "runtime": {
            "name": "node",
            "version": "^24",
            "onFail": "error"
        }
    },
    "compatiblePackages": {
        "schemaVersion": 1,
        "vite": {
            "type": "compatible",
            "versions": "^8.0.0"
        }
    }
}
